# =============================================================================
# Threat Intel Agent - Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# --- LLM Configuration ---
# API key for the LLM provider (DeepSeek, OpenAI, etc.)
LLM_API_KEY=sk-your-api-key-here
# Base URL for the LLM API endpoint
LLM_BASE_URL=https://api.deepseek.com/v1
# Model name to use
LLM_MODEL_NAME=deepseek-chat
# Sampling temperature (0.0 - 1.0)
LLM_TEMPERATURE=0.1
# Maximum tokens per response
LLM_MAX_TOKENS=4096

# --- Database ---
# SQLite database URL (use aiosqlite driver for async support)
DATABASE_URL=sqlite+aiosqlite:///./threat_intel.db

# --- Vector Store ---
# Directory for ChromaDB persistence
CHROMA_PERSIST_DIR=./chroma_data

# --- Application ---
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# CORS allowed origins (JSON array)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# Secret key for JWT signing (auto-generated if empty)
SECRET_KEY=
# JWT access token expiration in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# JWT algorithm
ALGORITHM=HS256

# --- Rate Limiting ---
# Default rate limit per minute (overridden by middleware: 30 unauthenticated, 120 authenticated)
RATE_LIMIT_PER_MINUTE=60
# Maximum concurrent agent tasks
MAX_CONCURRENT_TASKS=3

# --- Default Admin ---
# Default admin credentials (change in production!)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# --- Threat Intelligence API Keys ---
# AlienVault OTX API key (https://otx.alienvault.com/)
ALIENVAULT_OTX_KEY=
# VirusTotal API key (https://www.virustotal.com/)
VIRUSTOTAL_API_KEY=
# AbuseIPDB API key (https://www.abuseipdb.com/)
ABUSEIPDB_API_KEY=
# ThreatBook API key (https://threatbook.cn/)
THREATBOOK_API_KEY=
# QiAnXin API key (https://ti.qianxin.com/)
QIANXIN_API_KEY=
# DeepSeek API key (alternative LLM provider)
DEEPSEEK_API_KEY=

# --- Telegram Collector ---
# Telegram Bot API token (optional, for dark web channel monitoring)
TELEGRAM_BOT_TOKEN=
